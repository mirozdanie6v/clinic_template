{
  "name": "clinic-template",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/apply-live-booking-ui.mjs && node scripts/apply-final-visual-ui.mjs && next dev",
    "build": "node scripts/apply-live-booking-ui.mjs && node scripts/apply-final-visual-ui.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "sync:client": "node scripts/sync-client-sources.mjs",
    "build:client": "node scripts/build-client-v3.mjs",
    "build:client:final": "node scripts/build-client-final.mjs",
    "validate:visual": "node scripts/validate-visual-readiness.mjs",
    "validate:product": "node scripts/validate-product-quality.mjs",
    "apply:clinic": "node scripts/apply-clinic-config.mjs"
  },
  "dependencies": {
    "next": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "^9.39.5",
    "eslint-config-next": "latest",
    "typescript": "^6.0.3"
  },
  "packageManager": "pnpm@10.15.1"
}
