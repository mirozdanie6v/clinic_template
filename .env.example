# Public clinic runtime
NEXT_PUBLIC_CLINIC_SLUG=clinic-template
NEXT_PUBLIC_CLINIC_APP_URL=https://clinic-template.example.com

# Altegio Online Booking API (server-side only)
ALTEGIO_PARTNER_TOKEN=

# OpenAI (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
CLINIC_AI_WORKER_URL=

# Telegram (server-side only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_CHAT_ID=

# Optional persistent backend
CLINIC_BACKEND_URL=
CLINIC_BACKEND_TOKEN=

# Cloudflare deployment credentials — never commit real values
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WORKER_NAME=clinic-template-backend
