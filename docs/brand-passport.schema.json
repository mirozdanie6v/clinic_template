{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clinic-template.local/schemas/brand-passport.v1.json",
  "title": "Client Brand Passport",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "client", "brand", "contacts", "locations", "dataSources", "catalog", "specialists", "integrations"],
  "properties": {
    "schemaVersion": {"const": 1},
    "client": {
      "type": "object",
      "required": ["slug", "name", "shortName", "businessType", "city", "country", "languages", "timezone"],
      "properties": {
        "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name": {"type": "string", "minLength": 1},
        "shortName": {"type": "string", "minLength": 1},
        "businessType": {"type": "string", "minLength": 1},
        "city": {"type": "string", "minLength": 1},
        "country": {"type": "string", "minLength": 1},
        "languages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "timezone": {"type": "string", "minLength": 1}
      },
      "additionalProperties": true
    },
    "brand": {"type": "object", "required": ["brandLine", "tagline", "theme"], "additionalProperties": true},
    "contacts": {"type": "object", "additionalProperties": true},
    "locations": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["id", "name", "address"], "additionalProperties": true}},
    "content": {"type": "object", "additionalProperties": true},
    "dataSources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog", "specialists", "booking"],
      "properties": {
        "catalog": {"$ref": "#/$defs/catalogRoute"},
        "specialists": {"$ref": "#/$defs/specialistRoute"},
        "booking": {"$ref": "#/$defs/bookingRoute"}
      }
    },
    "catalog": {"type": "object", "required": ["imports", "manualGroups"], "additionalProperties": true},
    "specialists": {"type": "object", "required": ["manual"], "additionalProperties": true},
    "integrations": {"type": "object", "additionalProperties": true}
  },
  "$defs": {
    "catalogRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "fallback", "required"],
      "properties": {
        "primary": {"enum": ["manual", "altegio-snapshot", "google-sheets", "external-api"]},
        "fallback": {"enum": ["manual", "none"]},
        "required": {"type": "boolean"}
      }
    },
    "specialistRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "fallback", "required"],
      "properties": {
        "primary": {"enum": ["manual", "altegio-snapshot", "google-sheets", "external-api"]},
        "fallback": {"enum": ["manual", "none"]},
        "required": {"type": "boolean"}
      }
    },
    "bookingRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "fallback", "required"],
      "properties": {
        "primary": {"enum": ["internal", "contact", "altegio", "external-api"]},
        "fallback": {"enum": ["contact", "none"]},
        "required": {"type": "boolean"}
      }
    }
  }
}
