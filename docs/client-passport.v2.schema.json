    "documents": {
      "type": "object",
      "required": [
        "legal", "brand", "brandVoice", "audiences", "contacts", "locations", "social", "content", "dataSources", "catalog", "specialists", "portfolio", "reviews", "faq", "offers", "seo", "assets", "integrations", "provenance", "dataQuality", "quality",
        "businessAnalysis", "psychologyMap", "offerArchitecture", "trustArchitecture", "productStrategy", "messagingGuide", "brandDiagnosis", "idealVisualStructure", "designSystemContract", "imageProductionPlan", "analyticsPlan", "learningLoop"
      ],
      "properties": {
        "visualDirection": {"type": "string"},
        "assetAudit": {"type": "string"},
        "quality": {"type": "string"},
        "businessAnalysis": {"type": "string"},
        "psychologyMap": {"type": "string"},
        "offerArchitecture": {"type": "string"},
        "trustArchitecture": {"type": "string"},
        "productStrategy": {"type": "string"},
        "messagingGuide": {"type": "string"},
        "brandDiagnosis": {"type": "string"},
        "idealVisualStructure": {"type": "string"},
        "designSystemContract": {"type": "string"},
        "imageProductionPlan": {"type": "string"},
        "analyticsPlan": {"type": "string"},
        "learningLoop": {"type": "string"}
      },
      "additionalProperties": {"type": "string"}
    }
  },
  "additionalProperties": false
}
