{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Client Passport v2",
  "type": "object",
  "required": ["schemaVersion", "client", "documents"],
  "properties": {
    "schemaVersion": {"const": 2},
    "client": {
      "type": "object",
      "required": ["slug", "name", "businessType", "city", "country", "languages", "timezone"]
